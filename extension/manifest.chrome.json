{
  "manifest_version": 3,
  "name": "Tab Rebase",
  "version": "0.2.0",
  "description": "Edit the tabs of a window in your $EDITOR, git-rebase style.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Edit tabs in editor"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open this window's tabs in the editor"
    }
  }
}
